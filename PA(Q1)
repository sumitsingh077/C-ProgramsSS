#include <stdio.h>

struct Date
{
    int day, month, year;
};

int calculateAge(struct Date dob)
{
    struct Date current = {26, 2, 2026}; // example current date
    return current.year - dob.year;
}

int main()
{
    struct Date dob;
    printf("Enter DOB (dd mm yyyy): ");
    scanf("%d %d %d", &dob.day, &dob.month, &dob.year);

    int age = calculateAge(dob);
    printf("Age = %d years", age);

    return 0;
}
