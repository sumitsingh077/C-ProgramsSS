#include <stdio.h>

struct Student
{
    char name[50];
    int roll_no;
    char mobile_no[15];
    float CGPA;
    char DoB[15];
    char course[20];
    int year;
};

void read(struct Student *s)
{
    printf("\nEnter Name: ");
    scanf("%s", s->name);
    printf("Enter Roll No: ");
    scanf("%d", &s->roll_no);
    printf("Enter Mobile No: ");
    scanf("%s", s->mobile_no);
    printf("Enter CGPA: ");
    scanf("%f", &s->CGPA);
    printf("Enter Date of Birth: ");
    scanf("%s", s->DoB);
    printf("Enter Course: ");
    scanf("%s", s->course);
    printf("Enter Year: ");
    scanf("%d", &s->year);
}

void display(struct Student s)
{
    printf("\nName: %s", s.name);
    printf("\nRoll No: %d", s.roll_no);
    printf("\nMobile: %s", s.mobile_no);
    printf("\nCGPA: %.2f", s.CGPA);
    printf("\nDOB: %s", s.DoB);
    printf("\nCourse: %s", s.course);
    printf("\nYear: %d\n", s.year);
}

int main()
{
    struct Student s[10];
    int i, topper = 0;

    for(i = 0; i < 10; i++)
    {
        printf("\nEnter details of Student %d", i+1);
        read(&s[i]);
    }

    for(i = 1; i < 10; i++)
    {
        if(s[i].CGPA > s[topper].CGPA)
        {
            topper = i;
        }
    }

    printf("\nTopper of the class is:\n");
    display(s[topper]);

    return 0;
}
